# Copy this file to ".env.local" for local development (".env.local" is git-ignored).
# For the live site, add the same names as GitHub repo secrets (see FIREBASE_SETUP.md).
# These are NOT passwords – a Firebase web config is public by design.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=
# Your Google account email – the ONLY account allowed to edit the site
VITE_ADMIN_EMAIL=you@gmail.com
